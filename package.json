{
  "name": "taskory-hub-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_STAGE=development vite",
    "build": "tsc -b && vite build",
    "build:qa": "npm run build -- --mode qa",
    "deploy:qa": "npm run build:qa && wrangler pages deploy --branch qa",
    "build:prod": "npm run build -- --mode production",
    "deploy:prod": "npm run build:prod && wrangler pages deploy --branch main",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.74.4",
    "apisauce": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.6.0",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "lodash": "^4.18.1",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router": "^7.5.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.73.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.21.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "4.1.10",
    "wrangler": "^4.24.3"
  }
}
